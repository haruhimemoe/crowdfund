{
  "name": "@haruhimemoe/crowdfund",
  "version": "0.1.0",
  "description": "Crowdfunding state as data: zod schemas for goals, tiers, donations and refunds, integer minor-unit money math in any currency, goal progress, stretch tiers, top donors that respect anonymity, dedupe, and Ko-fi webhook helpers. Never moves money. No dependencies besides zod.",
  "keywords": [
    "crowdfund",
    "crowdfunding",
    "donations",
    "funding goal",
    "stretch goals",
    "ko-fi",
    "webhook",
    "zod"
  ],
  "homepage": "https://github.com/haruhimemoe/crowdfund#readme",
  "bugs": "https://github.com/haruhimemoe/crowdfund/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haruhimemoe/crowdfund.git"
  },
  "license": "MIT",
  "author": "David (https://dvh.sh)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./kofi": {
      "types": "./dist/kofi/index.d.ts",
      "default": "./dist/kofi/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "bun@1.4.2",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "bun run clean && tsc -p tsconfig.build.json",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:dist": "bun run build && node scripts/smoke.mjs",
    "check:consumer": "bun run build && node scripts/check-consumer.mjs",
    "prepublishOnly": "bun run check && bun run typecheck && bun run test && bun run test:dist"
  },
  "peerDependencies": {
    "zod": "^4.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "26.6.2",
    "@vitest/coverage-v8": "5.0.1",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "vitest": "5.0.1",
    "zod": "4.6.5"
  }
}
